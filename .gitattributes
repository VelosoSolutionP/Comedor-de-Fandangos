# Este projeto roda em containers Linux. Tudo no repositorio fica em LF e e
# entregue em LF no checkout, inclusive no Windows: um CRLF que vaze para o
# wildfly-config.cli ou para os scripts de init do Postgres quebra o build.
* text=auto eol=lf

*.sql   text eol=lf
*.sh    text eol=lf
*.cli   text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
*.java  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf
